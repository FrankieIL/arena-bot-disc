# Discord application credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Guild (server) ID to register slash commands to for instant updates during development.
# Leave blank to register commands globally instead (can take up to an hour to propagate).
GUILD_ID=

# Minimum delay (ms) enforced between outbound requests to arenasweats.lol.
REQUEST_DELAY_MS=100

# Riot Games API key — https://developer.riotgames.com
# Must be a Personal API key (register an app on the dev portal — free, no
# approval needed, and it never expires). Do NOT use the "development key"
# shown on the portal homepage; that one expires every 24 hours and would
# silently break Solo Queue lookups daily.
RIOT_API_KEY=

# Minimum delay (ms) enforced between outbound requests to Riot's API.
RIOT_REQUEST_DELAY_MS=1300
