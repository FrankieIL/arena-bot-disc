# Discord application credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Guild (server) ID to register slash commands to for instant updates during development.
# Leave blank to register commands globally instead (can take up to an hour to propagate).
GUILD_ID=

# Minimum delay (ms) enforced between outbound requests to arenasweats.lol.
REQUEST_DELAY_MS=100
